<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xiaohong.backup_weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@@REPO_ROOT@@/launchd/scripts/backup_data_lake.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@REPO_ROOT@@</string>

    <!-- 每週日 03:00 AM（半夜沒流量、不會跟 04:00 的 internal_ingest_daily 撞）-->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- load 時不自動跑（只在每週日 03:00 排程跑）-->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@@REPO_ROOT@@/var/logs/backup_weekly.log</string>
    <key>StandardErrorPath</key>
    <string>@@REPO_ROOT@@/var/logs/backup_weekly.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 走共用 chroma server，勿開 embedded PersistentClient(會與 server 搶同一份 HNSW 索引→SIGSEGV) -->
        <key>RED_CHROMA_HTTP_URL</key>
        <string>http://127.0.0.1:8000</string>
        <!-- 異地災備目的地：每週把無可取代的狀態包推一份到 Google Drive。
             個人 Drive 路徑不寫進 template（避免帳號/路徑進 git）；redeploy-daemons
             部署時用環境變數 $RED_OFFSITE_DIR 代換 @@RED_OFFSITE_DIR@@。沒設＝空＝
             靜默跳過異地推送。只推狀態包、不推 chroma clone(衍生、可由 rag_sync 重建)。 -->
        <key>RED_OFFSITE_DIR</key>
        <string>@@RED_OFFSITE_DIR@@</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>RED_EMBED_DIM</key>
        <string>768</string>
    </dict>
</dict>
</plist>
