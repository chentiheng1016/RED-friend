<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xiaohong.ingest_oneoff</string>

    <key>ProgramArguments</key>
    <array>
        <string>@@REPO_ROOT@@/.venv/bin/python</string>
        <string>-c</string>
        <string>from agent_core.internal_emails import ingest_internal_emails; print(ingest_internal_emails(days_back=3650, max_threads=100000, parallel_workers=1))</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@REPO_ROOT@@</string>

    <!-- 一次性回填：RunAtLoad=false — 以前設 true，每次開機 / redeploy 重載 plist
         都會把 3650 天全量回填重跑一輪（健檢 Low）。要跑請手動觸發：
           launchctl kickstart gui/$(id -u)/com.xiaohong.ingest_oneoff -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@@REPO_ROOT@@/var/logs/ingest_internal.log</string>
    <key>StandardErrorPath</key>
    <string>@@REPO_ROOT@@/var/logs/ingest_internal.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 走共用 chroma server，勿開 embedded PersistentClient(會與 server 搶同一份 HNSW 索引→SIGSEGV) -->
        <key>RED_CHROMA_HTTP_URL</key>
        <string>http://127.0.0.1:8000</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>AGENT_DAEMON_MODE</key>
        <string>1</string>
        <!-- 讓 print() 立刻寫 log 不被 block-buffer 卡住 -->
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>RED_EMBED_DIM</key>
        <string>768</string>
    </dict>
</dict>
</plist>
