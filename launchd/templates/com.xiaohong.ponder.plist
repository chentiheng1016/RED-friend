<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xiaohong.ponder</string>

    <key>ProgramArguments</key>
    <array>
        <string>@@REPO_ROOT@@/.venv/bin/python</string>
        <string>@@REPO_ROOT@@/launchd/scripts/ponder.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@REPO_ROOT@@</string>

    <!-- 每 7200 秒 = 2 小時跑一次；腳本內會判斷 9:00-22:00 才動作 -->
    <key>StartInterval</key>
    <integer>7200</integer>

    <key>StandardOutPath</key>
    <string>@@REPO_ROOT@@/var/logs/daemon-ponder.log</string>
    <key>StandardErrorPath</key>
    <string>@@REPO_ROOT@@/var/logs/daemon-ponder.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 整個 fleet 的 Gemini model；preview tier 高負載會回 503，
             用 gemini-flash-latest 較穩。改完跑 redeploy-daemons -f。 -->
        <key>RED_GEMINI_MODEL</key>
        <string>gemini-flash-latest</string>
        <key>RED_GEMINI_FALLBACK_MODEL</key>
        <string>gemini-2.5-flash-lite</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>RED_CHROMA_HTTP_URL</key>
        <string>http://127.0.0.1:8000</string>
        <key>RED_EMBED_DIM</key>
        <string>768</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
