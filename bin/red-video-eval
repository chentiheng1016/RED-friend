#!/bin/bash
# 影片學習評測集 CLI — 建題庫、人工核題、跑評測、看走勢。
#
# 用法：
#   ./bin/red-video-eval list
#   ./bin/red-video-eval draft  <video_id> <影片名> <分析文字檔> [題數]
#   ./bin/red-video-eval verify <video_id> [qid ...]     # 不給 qid = 全部轉正
#   ./bin/red-video-eval run    <video_id> <候選文字檔> [label]
#   ./bin/red-video-eval report <video_id>
#
# 工作流：draft 從既有分析草擬題目 → 人工打開 var/data/video_eval/<id>.json
# 核對/修正答案 → verify 轉正 → 每次管線改動後 run 一次（label 標版本）→
# report 看分數走勢。草稿題不進評分母體。

set -e
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$( dirname "$SCRIPT_DIR" )"

PYBIN="$REPO_ROOT/.venv/bin/python"
if [ ! -x "$PYBIN" ]; then
    echo "❌ 找不到 ${PYBIN} — 請先跑 setup.sh 建 venv"
    exit 1
fi

cd "$REPO_ROOT"
exec "$PYBIN" - "$@" <<'PY'
import json
import sys

from agent_core import video_eval as ve


def _read(path: str) -> str:
    with open(path, encoding="utf-8") as f:
        return f.read()


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "help"
    if cmd == "list":
        sets = ve.list_eval_sets()
        if not sets:
            print("還沒有任何評測題庫。先用 draft 建一份。")
            return 0
        for s in sets:
            print(f"{s['video_id']}  題數={s['questions']}"
                  f"（verified {s['verified']}）  {s['video_name']}")
        return 0
    if cmd == "draft" and len(argv) >= 4:
        n = int(argv[4]) if len(argv) > 4 else 12
        r = ve.draft_eval_questions(argv[1], argv[2], _read(argv[3]), n=n)
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0 if r.get("ok") else 1
    if cmd == "verify" and len(argv) >= 2:
        r = ve.verify_questions(argv[1], argv[2:] or None)
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0 if r.get("ok") else 1
    if cmd == "run" and len(argv) >= 3:
        label = argv[3] if len(argv) > 3 else ""
        r = ve.run_eval(argv[1], _read(argv[2]), label=label)
        if r.get("ok"):
            v = r.get("verdicts", {})
            print(f"score={r['score']:.2f}  coverage={r['coverage']:.2f}  "
                  f"(✓{v.get('correct', 0)} ±{v.get('partial', 0)} "
                  f"✗{v.get('wrong', 0)} ∅{v.get('not_covered', 0)})")
            for item in r.get("results", []):
                mark = {"correct": "✓", "partial": "±",
                        "wrong": "✗", "not_covered": "∅"}[item["verdict"]]
                print(f"  {mark} [{item['id']}] {item['question']}"
                      + (f" — {item['note']}" if item.get("note") else ""))
        else:
            print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0 if r.get("ok") else 1
    if cmd == "report" and len(argv) >= 2:
        print(ve.format_eval_report(argv[1]))
        return 0
    print(__doc__ or "用法見 bin/red-video-eval 檔頭註解。")
    print("子命令：list | draft <video_id> <影片名> <分析文字檔> [題數] | "
          "verify <video_id> [qid ...] | run <video_id> <候選文字檔> [label] | "
          "report <video_id>")
    return 2


sys.exit(main(sys.argv[1:]))
PY
